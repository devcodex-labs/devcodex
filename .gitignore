# Root .gitignore — DevCodex refactor workspace
node_modules/
.github/*
!.github/workflows/
!.github/workflows/**
# DevCodex Claude Code adapter output (devcodex init --claude target; do not commit in source repo)
.claude/
# DevCodex Codex adapter output (devcodex init --codex target; do not commit in source repo)
.agents/
.codex/
AGENTS.md
CLAUDE.md
.vscode/
dist/
coverage/
*.log
.env
.env.local

# DevCodex AI context data (session memory, reports, profile, etc. - do not commit)
.devcodex/


# npm auth (never commit tokens)
.npmrc


# Hook replay payloads (local validation only, do not commit)
.tmp-hook-editfiles.json
.tmp-hook-terminal.json

source-root-deployment-backup-*/
tmp-validate*.txt
package.json.tmp-test

