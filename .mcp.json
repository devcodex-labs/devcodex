{
  "$schema": "https://json.schemastore.org/mcp-servers.json",
  "servers": {
    "devcodex-memory": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/.claude/mcp/memory-server.js",
        "${workspaceFolder}"
      ],
      "_note": "Reads/writes .devcodex/.memory/ session files and records CP confirmations."
    },
    "devcodex-profile": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/.claude/mcp/profile-server.js",
        "${workspaceFolder}"
      ],
      "_note": "Loads .devcodex/profile/ files and returns ENV_MODE / agent config."
    }
  }
}
