{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcodex.dev/schemas/capability-intent-decision.v1.schema.json",
  "title": "CapabilityIntentDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "instructionRefId",
    "workflowIntent",
    "capabilityClass",
    "capabilityFamilyId",
    "selectedPortableDecision",
    "confidence",
    "reasonCode",
    "reason",
    "autoAuthorityRef",
    "appliedInvariantIds",
    "nativeEligibility",
    "fallback",
    "receipt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "CapabilityIntentDecisionV1"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "instructionRefId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workflowIntent": {
      "enum": [
        "dev",
        "fix",
        "analyze",
        "audit",
        "self-fix",
        "other"
      ]
    },
    "capabilityClass": {
      "const": "portableDecision"
    },
    "capabilityFamilyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "selectedPortableDecision": {
      "enum": [
        "direct",
        "plan_first",
        "auto_authorized"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "reasonCode": {
      "enum": [
        "SCOPE_BOUNDED_DIRECT",
        "COMPLEXITY_REQUIRES_PLAN",
        "AUTO_AUTHORITY_VALID",
        "INTENT_CONFIDENCE_LOW",
        "HOST_VARIANT_UNKNOWN",
        "CATALOG_UNAVAILABLE",
        "CATALOG_DUPLICATE_KEY",
        "CATALOG_SOURCE_STALE",
        "NATIVE_EVIDENCE_STALE",
        "NATIVE_EVIDENCE_UNVERIFIED",
        "NATIVE_LIFECYCLE_INCOMPLETE",
        "NATIVE_PERMISSION_UNSAFE",
        "NATIVE_AUTHORITY_MISSING",
        "NATIVE_NOT_PHASE1",
        "AUTO_AUTHORITY_MISSING",
        "INSTRUCTION_SOURCE_MISSING",
        "INSTRUCTION_DIGEST_MISMATCH",
        "INSTRUCTION_AUTHORITY_TOO_WEAK",
        "HOST_UNSUPPORTED",
        "MCP_NOT_REQUIRED"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "autoAuthorityRef": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "appliedInvariantIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,63}$"
      }
    },
    "nativeEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "leverRef",
        "evidenceState",
        "permissionState",
        "lifecycleState"
      ],
      "properties": {
        "status": {
          "enum": [
            "eligible",
            "ineligible",
            "unverified",
            "unsupported",
            "not-evaluated"
          ]
        },
        "leverRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "evidenceState": {
          "enum": [
            "fresh",
            "stale",
            "unverified",
            "unsupported",
            "missing",
            "not-evaluated"
          ]
        },
        "permissionState": {
          "enum": [
            "safe",
            "unsafe",
            "unknown",
            "not-evaluated"
          ]
        },
        "lifecycleState": {
          "enum": [
            "complete",
            "incomplete",
            "unknown",
            "not-evaluated"
          ]
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "reasonCode",
        "target",
        "retryable"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "reasonCode": {
          "enum": [
            "NOT_REQUIRED",
            "HOST_VARIANT_UNKNOWN",
            "CATALOG_UNAVAILABLE",
            "CATALOG_DUPLICATE_KEY",
            "CATALOG_SOURCE_STALE",
            "NATIVE_EVIDENCE_STALE",
            "NATIVE_EVIDENCE_UNVERIFIED",
            "NATIVE_LIFECYCLE_INCOMPLETE",
            "NATIVE_PERMISSION_UNSAFE",
            "NATIVE_AUTHORITY_MISSING",
            "NATIVE_NOT_PHASE1",
            "HOST_UNSUPPORTED",
            "MCP_NOT_REQUIRED"
          ]
        },
        "target": {
          "const": "portable"
        },
        "retryable": {
          "const": false
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "hostSurfaceOrVariant",
        "catalogVersion",
        "catalogFileDigest",
        "sourceHead",
        "decidedAt",
        "validationOwner"
      ],
      "properties": {
        "hostId": {
          "type": "string",
          "minLength": 1
        },
        "hostSurfaceOrVariant": {
          "type": "string",
          "minLength": 1
        },
        "catalogVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "catalogFileDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sourceHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "validationOwner": {
          "const": "host-capability-routing"
        }
      }
    }
  }
}
