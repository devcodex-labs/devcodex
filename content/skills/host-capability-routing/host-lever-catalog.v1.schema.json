{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcodex.dev/schemas/host-lever-catalog.v1.schema.json",
  "title": "HostLeverCatalogV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "sourceMatrixRef",
    "entries",
    "unsupportedSurfaces",
    "invalidationTriggers",
    "writer"
  ],
  "properties": {
    "schemaVersion": {
      "const": "HostLeverCatalogV1"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sourceMatrixRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schemaVersion",
        "matrixId",
        "sourceHead"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": "HostAdapterCompatibilityMatrixV1"
        },
        "matrixId": {
          "type": "string",
          "pattern": "^always-on-host-[a-f0-9]{64}$"
        },
        "sourceHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostId",
          "hostSurfaceOrVariant",
          "capabilityFamilyId",
          "leverVersion",
          "leverType",
          "invocation",
          "automationAuthority",
          "eligibility",
          "evidence",
          "permission",
          "lifecycle",
          "fallback",
          "validation",
          "freshness"
        ],
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1
          },
          "hostSurfaceOrVariant": {
            "type": "string",
            "minLength": 1
          },
          "capabilityFamilyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "leverVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "leverType": {
            "enum": [
              "none",
              "native-plan",
              "permission-mode",
              "agent-mode",
              "launcher"
            ]
          },
          "invocation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "automationAuthority": {
            "enum": [
              "none",
              "host-user-action",
              "explicit-user",
              "existing-auto-evidence"
            ]
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "prerequisites",
              "requiredEvidence",
              "requiresExplicitUserAuthority"
            ],
            "properties": {
              "status": {
                "enum": [
                  "portable-only",
                  "phase2-candidate",
                  "unverified",
                  "blocked"
                ]
              },
              "prerequisites": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "requiredEvidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "requiresExplicitUserAuthority": {
                "type": "boolean"
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceStatus",
              "evidenceRef",
              "evidenceCheckedAt",
              "evidenceLease"
            ],
            "properties": {
              "evidenceStatus": {
                "enum": [
                  "PASS",
                  "WARN",
                  "UNVERIFIED"
                ]
              },
              "evidenceRef": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidenceCheckedAt": {
                "type": "string",
                "format": "date-time"
              },
              "evidenceLease": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "duration",
                  "sourceHead"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "repo-local",
                      "official-docs",
                      "direct-host-replay",
                      "unverified"
                    ]
                  },
                  "duration": {
                    "enum": [
                      "source-bound",
                      "P30D",
                      "P14D",
                      "P0D"
                    ]
                  },
                  "sourceHead": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{40,64}$"
                  }
                }
              }
            }
          },
          "permission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "permissionDelta",
              "writeBoundary"
            ],
            "properties": {
              "permissionDelta": {
                "enum": [
                  "none",
                  "bounded",
                  "elevated",
                  "unknown"
                ]
              },
              "writeBoundary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enter",
              "approve",
              "cancel",
              "exit"
            ],
            "properties": {
              "enter": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "observable",
                  "evidenceRef"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observable": {
                    "type": "boolean"
                  },
                  "evidenceRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "approve": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "observable",
                  "evidenceRef"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observable": {
                    "type": "boolean"
                  },
                  "evidenceRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "cancel": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "observable",
                  "evidenceRef"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observable": {
                    "type": "boolean"
                  },
                  "evidenceRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "exit": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "observable",
                  "evidenceRef"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observable": {
                    "type": "boolean"
                  },
                  "evidenceRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "fallback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "portableDecision",
              "reasonCode",
              "retryable"
            ],
            "properties": {
              "portableDecision": {
                "enum": [
                  "direct",
                  "plan_first",
                  "auto_authorized"
                ]
              },
              "reasonCode": {
                "enum": [
                  "NATIVE_EVIDENCE_UNVERIFIED",
                  "NATIVE_EVIDENCE_STALE",
                  "NATIVE_LIFECYCLE_INCOMPLETE",
                  "NATIVE_PERMISSION_UNSAFE",
                  "NATIVE_AUTHORITY_MISSING",
                  "NATIVE_NOT_PHASE1"
                ]
              },
              "retryable": {
                "const": false
              }
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "negativeProbe",
              "runtimeOwner",
              "validationOwner"
            ],
            "properties": {
              "negativeProbe": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "runtimeOwner": {
                "type": "string",
                "minLength": 1
              },
              "validationOwner": {
                "const": "host-capability-routing"
              }
            }
          },
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invalidationTriggers"
            ],
            "properties": {
              "invalidationTriggers": {
                "type": "array",
                "minItems": 7,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "schema",
                    "source",
                    "host",
                    "protocol",
                    "evidence",
                    "consumer",
                    "runtime-owner"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "unsupportedSurfaces": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostId",
          "hostSurfaceOrVariant",
          "reasonCode",
          "fallback",
          "evidenceRef"
        ],
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1
          },
          "hostSurfaceOrVariant": {
            "type": "string",
            "minLength": 1
          },
          "reasonCode": {
            "const": "HOST_UNSUPPORTED"
          },
          "fallback": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRef": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "invalidationTriggers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "schema",
          "source",
          "host",
          "protocol",
          "evidence",
          "consumer",
          "runtime-owner"
        ]
      }
    },
    "writer": {
      "const": "host-capability-routing/catalog-maintainer"
    }
  }
}
