{
  "schemaVersion": 1,
  "ownerSkill": "test-router",
  "gateRegistryRef": "skills/spec-governance/gate-registry.json",
  "stableInputs": ["workflow", "changeTypes", "risk", "publicSurface", "runtimeBoundary", "profileConstraints", "candidateState", "capabilitySurfaceDecision", "requestedClaims", "verificationIntent"],
  "verificationIntent": {
    "schemaVersion": "VerificationIntentV2",
    "levels": ["V0", "V1", "V2", "V3"],
    "purposes": ["edit-loop", "delivery", "boundary", "full-audit", "release"],
    "requiredFields": ["requesterClass", "requestedLevel", "requestedPurpose", "affectedBoundaries", "riskClass", "requestSourceRef", "project", "candidateId", "changedScopeDigest", "claimCeiling", "requestDigest"],
    "executionAuthoritySchema": "VerificationExecutionLeaseV2",
    "legacyExecutionAuthorityReaderSchemas": ["VerificationExecutionLeaseV1"],
    "legacyReaderSchemas": ["VerificationIntentV1"],
    "forbiddenImplicitAuthorities": ["risk", "reviewGrade", "controlPlane", "ecr", "cacheMiss", "cacheStale", "consumerGraphIncomplete", "unknownInput"]
  },
  "executionLevels": [
    { "id": "V0", "purpose": "edit-loop", "maximumClaim": "edit-evidence-only" },
    { "id": "V1", "purpose": "delivery", "maximumClaim": "delivery-scope" },
    { "id": "V2", "purpose": "boundary", "maximumClaim": "boundary-qualified" },
    { "id": "V3", "purpose": "full-audit-or-release", "maximumClaim": "full-audit-or-release-candidate" }
  ],
  "consumerEdgeTypes": ["runtimeConsumer", "qualificationConsumer", "releaseConsumer"],
  "scopedRouteBoundaries": {
    "profile-deploy": "profile",
    "package-release": "package"
  },
  "executionBinding": {
    "planSchema": "ValidationPlanV3",
    "requiredFields": ["manifestIdentity", "projectRootIdentity", "candidateId", "candidateStable", "candidateDigest", "dirtyScopeDigest", "changedScopeDigest", "planDigest", "budgetDigest", "requestDigest", "actorIdentityDigest", "runIdentityDigest", "runId", "hardDeadlineAt", "authorityDigest"],
    "cacheSchema": "ValidationEvidenceV2",
    "cacheNamespace": "validation-evidence/v2",
    "nodeBindingFields": ["HEAD", "matchedDirtyInputs", "nodeContract", "nodeVerificationPolicy", "dependencyReceiptDigests", "runtime"],
    "downstreamBinding": "nodeReceiptDigest",
    "v3CacheReuse": false
  },
  "budgetPolicy": {
    "schemaVersion": "BudgetCardV1",
    "pendingBindingSchema": "PendingBudgetCardBindingV1",
    "confirmationReceiptSchema": "BudgetConfirmationReceiptV1",
    "continuationAuthorizationSchema": "ValidationContinuationAuthorizationV1",
    "nonReleaseThresholdMs": 600000,
    "confirmationBinding": "planDigest+budgetDigest",
    "confirmationRequiredWhen": ["level=V3", "estimatedDurationMs>600000", "heavyNodeIds>0"],
    "durationEstimate": "manifest estimate or capped default; timeout upper bound reported separately",
    "estimateConfidenceValues": ["low", "medium", "high"],
    "requiredCardFields": ["estimatedDurationMs", "estimateConfidence", "hardTimeoutUpperBoundMs", "logBudgetBytes", "heavyNodeIds", "waitReasons"],
    "formalTaskBindingRequiredForAi": true,
    "autoMaximumLevel": "V2",
    "boundedContinuation": {
      "rootRelative": true,
      "maximumRetries": 2,
      "maximumAddedNodes": "min(3,max(1,ceil(rootSelectedNodeCount*0.05)))",
      "maximumEstimatedDeltaMs": "min(60000,ceil(rootEstimatedDurationMs*0.05))",
      "maximumHardTimeoutDeltaMs": "min(600000,ceil(rootHardTimeoutUpperBoundMs*0.05)) for proven repairs; zero for same-scope-retry",
      "maximumLogBudgetDeltaBytes": "min(65536,ceil(rootLogBudgetBytes*0.05)) for proven repairs; zero for same-scope-retry",
      "requiresSamePurposeAndNarrowerBoundaries": true,
      "repairProofKinds": ["mutation-observation", "committed-repair-diff", "same-scope-retry"],
      "committedRepairDiffRequires": ["stableCleanCandidate", "strictGitDescendant", "parentChangedScopeUntruncatedAndSubset", "completeCommitDiffInsideExplicitChangedScope"],
      "sameScopeRetryRequires": ["stableCandidate", "sameHead", "noNewDirtyPaths", "noAddedNodes", "noBudgetIncrease"],
      "planOnlyPreflightMatchesExecution": true,
      "retryExhaustionAction": "block-without-auto-root-rollover",
      "expiredAutoIngress": "existing-root-continuation-only",
      "freshControlRequiredFor": ["create-root", "replace-root", "V3", "full-audit", "release"],
      "revocationEpochBound": true
    },
    "unknownImpactAction": "block",
    "staleCacheAction": "rerun-precise-node"
  },
  "selectors": [
    { "id": "static", "when": "source or contract changes", "evidence": ["command", "exitCode"] },
    { "id": "unit-integration", "when": "behavior or cross-module changes", "evidence": ["suite", "result", "coverageDecision"] },
    { "id": "api", "when": "HTTP or public API boundary", "evidence": ["endpointMatrix", "httpArtifact", "cjsArtifact", "result"] },
    { "id": "runtime-e2e", "when": "user path or runtime state changes", "evidence": ["target", "stateMatrix", "result"] },
    { "id": "package-release", "when": "package candidate or release claim", "evidence": ["candidateDiff", "pack", "install", "registry"] },
    { "id": "profile-deploy", "when": "Profile, host or distribution changes", "evidence": ["profileValidation", "deploymentParity"] }
  ],
  "outputs": ["verificationIntent", "validationPlan", "budgetCard", "pendingBudgetCardBinding", "budgetConfirmationReceipt", "validationContinuationAuthorization", "verificationExecutionLease", "validationExecutionReceipt", "selectedRoutes", "commands", "evidence", "skipped", "residualRisk", "coverageClaim"],
  "skipRequiredFields": ["route", "reason", "authority", "residualRisk", "upgradeCondition"]
}
