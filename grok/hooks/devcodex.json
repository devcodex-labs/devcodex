{
  "description": "DevCodex lifecycle bridge for Grok Build; project hooks require explicit trust.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),p=require('path');const roots=[process.env.GROK_PLUGIN_ROOT,'.grok/devcodex/plugins/devcodex-workspace','.grok/plugins/devcodex-workspace'].filter(Boolean);const f=roots.map(x=>p.resolve(x,'hooks','session-start.cjs')).find(x=>fs.existsSync(x));if(f)require(f).main();\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
