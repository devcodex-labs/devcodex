{
  "description": "DevCodex lifecycle bridge for Grok Build; project hooks require explicit trust.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs'),p=require('path'),o=require('os');const root=p.resolve(process.env.GROK_PLUGIN_DATA||o.tmpdir());const d=p.join(root,'devcodex-grok-session-stamps');const raw=String(process.env.GROK_SESSION_ID||'s');const safe=(raw.replace(/[^\\w.-]+/g,'_').replace(/^\\.+/,'_').replace(/^_+$/,'_')||'s');const target=p.resolve(d,safe+'.json');const rel=p.relative(d,target);if(rel.startsWith('..')||p.isAbsolute(rel))process.exit(0);fs.mkdirSync(d,{recursive:true});fs.writeFileSync(target,JSON.stringify({schemaVersion:'GrokSessionStartStampV1',sessionId:raw,stampedAt:new Date().toISOString(),cwd:process.cwd()}));\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/_runtime/lifecycle-host-adapters.cjs grok"
          }
        ]
      }
    ]
  }
}
