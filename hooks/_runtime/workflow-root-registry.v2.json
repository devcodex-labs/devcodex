{
  "schemaVersion": "WorkflowRootRegistryV2",
  "environmentModes": [
    "dev",
    "prod"
  ],
  "workflowPolicies": {
    "analyze": {
      "mutationPolicy": "forbidden",
      "cpPolicy": {
        "cp1": "not-applicable",
        "cp2": "not-applicable",
        "cp3": "not-applicable",
        "cp3Rule": "read-only convergence workflow; requested mutation requires rerouting"
      },
      "artifactPolicy": {
        "primaryArtifacts": [
          "analysis-report",
          "convergence-evidence"
        ],
        "writePolicy": "forbidden"
      },
      "verificationPolicy": {
        "mode": "read-only",
        "executionAuthorityRequired": false
      },
      "resumePolicy": {
        "mode": "persist-round-trip",
        "terminalAction": "unbind"
      }
    },
    "audit": {
      "mutationPolicy": "forbidden",
      "cpPolicy": {
        "cp1": "not-applicable",
        "cp2": "not-applicable",
        "cp3": "not-applicable",
        "cp3Rule": "read-only review; findings are recorded and handed to an independently authorized repair workflow"
      },
      "artifactPolicy": {
        "primaryArtifacts": [
          "audit-state",
          "review-checklist",
          "audit-report"
        ],
        "writePolicy": "forbidden"
      },
      "verificationPolicy": {
        "mode": "read-only",
        "executionAuthorityRequired": false
      },
      "resumePolicy": {
        "mode": "persist-round-trip",
        "terminalAction": "unbind"
      }
    },
    "chat": {
      "mutationPolicy": "forbidden",
      "cpPolicy": {
        "cp1": "not-applicable",
        "cp2": "not-applicable",
        "cp3": "not-applicable",
        "cp3Rule": "question-answer fast path"
      },
      "artifactPolicy": {
        "primaryArtifacts": [],
        "writePolicy": "forbidden"
      },
      "verificationPolicy": {
        "mode": "read-only",
        "executionAuthorityRequired": false
      },
      "resumePolicy": {
        "mode": "persist-round-trip",
        "terminalAction": "unbind"
      }
    },
    "dev": {
      "mutationPolicy": "allowed-after-confirmation",
      "cpPolicy": {
        "cp1": "required",
        "cp2": "required",
        "cp3": "conditional",
        "cp3Rule": "required when an implementation plan is material; docs, init, plan-review and low-risk bounded changes may record N/A with subtype evidence"
      },
      "artifactPolicy": {
        "primaryArtifacts": [
          "requirements",
          "technical-design",
          "implementation-plan",
          "report"
        ],
        "writePolicy": "allowed-after-confirmation"
      },
      "verificationPolicy": {
        "mode": "affected-v0-v2",
        "executionAuthorityRequired": true
      },
      "resumePolicy": {
        "mode": "persist-round-trip",
        "terminalAction": "unbind"
      }
    },
    "fix": {
      "mutationPolicy": "allowed-after-confirmation",
      "cpPolicy": {
        "cp1": "required",
        "cp2": "required",
        "cp3": "conditional",
        "cp3Rule": "required for multi-file, high-risk or planned repairs; bounded low-risk fixes may record N/A with evidence"
      },
      "artifactPolicy": {
        "primaryArtifacts": [
          "bug-overview",
          "problem-analysis",
          "repair-plan",
          "report"
        ],
        "writePolicy": "allowed-after-confirmation"
      },
      "verificationPolicy": {
        "mode": "affected-v0-v2",
        "executionAuthorityRequired": true
      },
      "resumePolicy": {
        "mode": "persist-round-trip",
        "terminalAction": "unbind"
      }
    },
    "other": {
      "mutationPolicy": "forbidden",
      "cpPolicy": {
        "cp1": "not-applicable",
        "cp2": "not-applicable",
        "cp3": "not-applicable",
        "cp3Rule": "planning fallback only; explicit file mutation belongs to dev, fix or self-fix"
      },
      "artifactPolicy": {
        "primaryArtifacts": [
          "plan"
        ],
        "writePolicy": "forbidden"
      },
      "verificationPolicy": {
        "mode": "read-only",
        "executionAuthorityRequired": false
      },
      "resumePolicy": {
        "mode": "persist-round-trip",
        "terminalAction": "unbind"
      }
    },
    "resume": {
      "mutationPolicy": "inherited",
      "cpPolicy": {
        "cp1": "inherited",
        "cp2": "inherited",
        "cp3": "inherited",
        "cp3Rule": "rehydrate file truth, then return to the original workflow and stage"
      },
      "artifactPolicy": {
        "primaryArtifacts": [
          "context-handoff"
        ],
        "writePolicy": "inherited"
      },
      "verificationPolicy": {
        "mode": "inherited-after-rehydrate",
        "executionAuthorityRequired": true
      },
      "resumePolicy": {
        "mode": "rehydrate-return",
        "terminalAction": "unbind"
      }
    },
    "self-fix": {
      "mutationPolicy": "allowed-after-confirmation",
      "cpPolicy": {
        "cp1": "required",
        "cp2": "required",
        "cp3": "conditional",
        "cp3Rule": "mechanical A1-A5 repairs may simplify; semantic control-plane changes route to the full dev plan"
      },
      "artifactPolicy": {
        "primaryArtifacts": [
          "problem-confirmation",
          "technical-design",
          "report"
        ],
        "writePolicy": "allowed-after-confirmation"
      },
      "verificationPolicy": {
        "mode": "affected-v0-v2",
        "executionAuthorityRequired": true
      },
      "resumePolicy": {
        "mode": "persist-round-trip",
        "terminalAction": "unbind"
      }
    }
  },
