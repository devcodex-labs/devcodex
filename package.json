{
  "name": "@vextjs/devcodex",
  "version": "1.3.5",
  "description": "DevCodex — AI-powered development workflow rules as a GitHub Copilot Agent Plugin",
  "main": "index.js",
  "bin": {
    "devcodex": "./index.js"
  },
  "scripts": {
    "test": "node index.js status",
    "test:init": "node index.js init --dry-run",
    "test:version": "node -e \"const p=require('./package.json');const pl=require('./plugin.json');if(p.version!==pl.version){console.error('Version mismatch:',p.version,'vs',pl.version);process.exit(1)}else{console.log('Version OK:',p.version)}\""
  },
  "keywords": [
    "copilot",
    "ai",
    "dev-guidelines",
    "workflow",
    "audit",
    "agent-plugin",
    "github-copilot"
  ],
  "author": "Rocky <rocky@vextjs.com> (https://github.com/vextjs)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vextjs/devcodex.git"
  },
  "homepage": "https://devcodex.dev",
  "bugs": {
    "url": "https://github.com/vextjs/devcodex/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "copilot-instructions.md",
    "plugin.json",
    ".mcp.json",
    "agents/",
    "skills/",
    "instructions/",
    "prompts/",
    "data/",
    "assets/",
    "RULES.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
