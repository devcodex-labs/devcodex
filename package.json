{
  "name": "@vextjs/devcodex",
  "version": "1.11.2",
  "description": "DevCodex — AI-powered development workflow rules for Copilot, Claude Code and Codex",
  "main": "index.js",
  "bin": {
    "devcodex": "index.js"
  },
  "scripts": {
    "test": "node scripts/validate-versions.js && node scripts/validate.js",
    "test:all": "npm test && node scripts/test-spec-governance.js && node scripts/test-hooks-runtime.js && node scripts/test-instruction-fallback-check.js && node scripts/test-mcp-servers.js && node scripts/test-migrate-layout.js && node scripts/test-pack-clean.js && npm --prefix website run build && npm audit --omit=dev && npm --prefix website audit --omit=dev && node scripts/check-syntax.js",
    "test:init": "node index.js init --dry-run",
    "test:hooks-runtime": "node scripts/test-hooks-runtime.js",
    "test:migrate-layout": "node scripts/test-migrate-layout.js",
    "test:version": "node scripts/validate-versions.js",
    "test:pack-clean": "node scripts/test-pack-clean.js",
    "test:spec-governance": "node scripts/test-spec-governance.js",
    "validate": "node scripts/validate.js"
  },
  "keywords": [
    "copilot",
    "ai",
    "dev-guidelines",
    "workflow",
    "audit",
    "agent-plugin",
    "github-copilot",
    "claude-code",
    "codex"
  ],
  "author": "Rocky <rocky@vextjs.com> (https://github.com/vextjs)",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vextjs/devcodex.git"
  },
  "homepage": "https://devcodex.dev",
  "bugs": {
    "url": "https://github.com/vextjs/devcodex/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "index.js",
    "instructions.md",
    "plugin.json",
    ".mcp.json",
    "agents/",
    "skills/",
    "instructions/",
    "prompts/",
    "hooks/",
    "codex/",
    "mcp/",
    "scripts/migrate-layout.js",
    "scripts/instruction-fallback-check.js",
    "data/templates/",
    "data/README.md",
    "assets/icon-512.png",
    "RULES.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
