{
  "_format": "DevCodex internal metadata — NOT a GitHub Copilot official format. Copilot reads .github/agents|skills|instructions|prompts directly.",
  "id": "devcodex",
  "version": "1.0.0",
  "name": "DevCodex",
  "publisher": "Rocky",
  "displayName": "DevCodex — AI Development Workflow Assistant",
  "description": "Standardized AI-assisted development workflow system for GitHub Copilot. Built on ai-dev-guidelines v5.",
  "icon": "assets/icon-512.png",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/vextjs/devcodex",
  "homepage": "https://devcodex.dev",
  "tier": "pro",
  "authentication": {
    "type": "token",
    "endpoint": "https://auth.devcodex.dev/validate",
    "cacheFile": ".copilot/token-cache.json",
    "offlineFallback": {
      "enabled": true,
      "defaultTier": "free",
      "maxOfflineDays": 7
    }
  },
  "agents": [
    {
      "id": "devcodex",
      "file": "agents/devcodex.agent.md",
      "tier": "free"
    }
  ],
  "skills": [
    { "id": "compliance",  "file": "skills/core/compliance/SKILL.md",  "tier": "pro"  },
    { "id": "memory",      "file": "skills/core/memory/SKILL.md",      "tier": "pro"  },
    { "id": "report",      "file": "skills/core/report/SKILL.md",      "tier": "pro"  },
    { "id": "cp-gate",     "file": "skills/core/cp-gate/SKILL.md",     "tier": "pro"  },
    { "id": "intent",      "file": "skills/core/intent/SKILL.md",      "tier": "free" },
    { "id": "summary",     "file": "skills/core/summary/SKILL.md",     "tier": "pro"  },
    { "id": "plan",        "file": "skills/core/plan/SKILL.md",        "tier": "pro"  }
  ],
  "_note_skills": "Workflow sub-type Skills (dev/fix/audit etc.) are declared via the agent's HTML comment list, not registered here.",
  "instructions": [
    { "id": "safety",       "file": "instructions/00-safety.instructions.md",      "tier": "free" },
    { "id": "common",       "file": "instructions/01-common.instructions.md",      "tier": "free" },
    { "id": "output-paths", "file": "instructions/02-output-paths.instructions.md","tier": "free" },
    { "id": "dev",          "file": "instructions/10-dev.instructions.md",         "tier": "pro"  },
    { "id": "fix",          "file": "instructions/11-fix.instructions.md",         "tier": "pro"  },
    { "id": "audit",        "file": "instructions/12-audit.instructions.md",       "tier": "pro"  },
    { "id": "analyze",      "file": "instructions/13-analyze.instructions.md",     "tier": "free" },
    { "id": "self-fix",     "file": "instructions/14-self-fix.instructions.md",    "tier": "pro"  },
    { "id": "memory-r",     "file": "instructions/15-memory.instructions.md",      "tier": "pro"  },
    { "id": "report-r",     "file": "instructions/16-report.instructions.md",      "tier": "pro"  },
    { "id": "compliance-r", "file": "instructions/17-compliance.instructions.md",  "tier": "pro"  }
  ],
  "hooks": {
    "pre":  "hooks/pre-message.hook.md",
    "post": "hooks/post-session.hook.md"
  },
  "mcp": {
    "file": ".mcp.json"
  },
  "keywords": ["copilot", "dev-guidelines", "workflow", "audit", "ai-dev"],
  "categories": ["Productivity", "Development Workflow"]
}
