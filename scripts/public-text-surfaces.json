{
  "schemaVersion": "PublicTextSurfacesV1",
  "surfaces": [
    { "path": "README.md", "role": "package-readme" },
    { "path": "changelogs/unreleased.md", "role": "current-changelog" },
    { "path": "website/docs/intro/index.md", "role": "website-home" },
    { "path": "website/docs/guide/index.md", "role": "website-guide-index" },
    { "path": "website/docs/guide/development.md", "role": "website-current-guide" },
    { "path": "website/docs/specs/directory-structure.md", "role": "website-current-spec" },
    { "path": "website/docs/intro/host-parity-grok.md", "role": "website-host-parity-grok" }
  ],
  "roots": [
    { "path": "content/instructions", "role": "normative-instructions", "extensions": [".md"] },
    { "path": "content/skills", "role": "normative-skills", "fileNames": ["SKILL.md"] },
    { "path": "content/prompts", "role": "normative-prompts", "extensions": [".md"] },
    { "path": "content/shared", "role": "normative-shared-fragments", "extensions": [".md"] },
    { "path": "host-projections", "role": "generated-host-contracts", "extensions": [".md"] },
    { "path": "codex", "role": "codex-host-contracts", "extensions": [".md"] },
    { "path": "agents", "role": "agent-host-contracts", "extensions": [".md"] },
    { "path": "grok", "role": "grok-host-contracts", "extensions": [".md"] },
    { "path": "website/docs/intro", "role": "website-current-intro", "extensions": [".md", ".mdx"] },
    { "path": "website/docs/guide", "role": "website-current-guide", "extensions": [".md", ".mdx"] },
    { "path": "website/docs/public", "role": "website-current-public", "extensions": [".md", ".mdx"] },
    { "path": "website/docs/specs", "role": "website-current-specs", "extensions": [".md", ".mdx"] },
    { "path": "changelogs", "role": "current-changelog-files", "fileNames": ["README.md", "TEMPLATE.md", "unreleased.md"] }
  ],
  "contaminationPatterns": [
    {
      "id": "validator-output-contamination",
      "pattern": "^\\s*\\[V\\d+[a-z]?\\].*(?:missing|drift|error|failed)",
      "flags": "gimu"
    }
  ],
  "highConfidenceMojibakePatterns": [
    {
      "id": "cjk-mojibake-cluster",
      "pattern": "(?:楠岃|鍓嶅|鍓嶇|澶嶅|璧勬簮|鏋舵瀯|鎸囨爣|闆跺|浣庡績|蹇冩櫤|缁存姢)",
      "flags": "gu"
    }
  ],
  "lowConfidenceMojibakePatterns": [
    {
      "id": "latin-mojibake-marker",
      "pattern": "(?:Ã.|Â.|â€|ï»¿)",
      "flags": "gu"
    }
  ],
  "allowlist": []
}
