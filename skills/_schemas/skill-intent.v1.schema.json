{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcodex.dev/schemas/skill-intent.v1.schema.json",
  "title": "SkillIntentV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skillId", "intents", "examples", "summary"],
  "properties": {
    "schemaVersion": { "const": "SkillIntentV1" },
    "skillId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 128
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "include"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "include": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 16 }
          }
        }
      }
    },
    "examples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 48 }
        },
        "negative": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      }
    },
    "summary": { "type": "string", "maxLength": 160 }
  }
}
