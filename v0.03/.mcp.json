{
  "$schema": "https://json.schemastore.org/mcp-servers.json",
  "_comment": "v5.0 占位配置，v5.1 实现 MCP Server 后更新 command/url 字段并设 disabled: false",
  "servers": {
    "devcodex-memory": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/mcp/memory-server.js"],
      "disabled": true,
      "tools": ["memory_read", "memory_write", "memory_list"],
      "resources": ["memory://sessions/**"]
    },
    "devcodex-violations": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/mcp/violations-server.js"],
      "disabled": true,
      "tools": ["violation_log", "violation_query", "violation_stats"]
    },
    "devcodex-auth": {
      "_comment": "规划中（v5.1）：auth 服务的 MCP 协议层，/mcp 端点尚未实现。当前 auth.devcodex.dev 只暴露 /validate 和 /auth/* REST 接口。disabled 保持 true 直到 v5.1 实现后更新。",
      "type": "http",
      "url": "https://auth.devcodex.dev/mcp",
      "disabled": true,
      "tools": ["token_validate", "token_refresh", "tier_check"]
    }
  }
}
