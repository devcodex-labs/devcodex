# GitHub OAuth App 配置（示例，勿提交真实值）
GITHUB_CLIENT_ID=Ov23liXXXXXXXXXXXXXX
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitHub App Webhook Secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# DevCodex Token 签发密钥（最少 32 字符）
JWT_SECRET=please_replace_with_a_strong_random_secret_min_32_chars

# 服务公网地址
DEVCODEX_BASE_URL=https://auth.devcodex.dev

# 监听端口（可选）
PORT=3300

# 环境
NODE_ENV=production
